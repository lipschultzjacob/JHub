# Copy this file to .env.local and fill in real values.
# .env.local is excluded from git (see .gitignore) — never commit real secrets.

# Matches docker-compose.yml's local Postgres credentials.
DATABASE_URL=postgresql://jhub:jhub_dev_password@localhost:5432/jhub

# From your Plaid dashboard (dashboard.plaid.com) -- use sandbox keys for local dev.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Used to encrypt login session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Web Push credentials (VAPID). Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Where this app is publicly reachable -- used to tell Plaid where to send
# webhook notifications. Leave unset for local dev (webhooks won't fire, use
# the manual "Sync transactions" button instead); set to the real deployed
# URL in production.
APP_URL=
