# Copy this file to .env.local and fill in real values.
# .env.local is excluded from git (see .gitignore) — never commit real secrets.

# Matches docker-compose.yml's local Postgres credentials.
DATABASE_URL=postgresql://jhub:jhub_dev_password@localhost:5432/jhub

# From your Plaid dashboard (dashboard.plaid.com) -- use sandbox keys for local dev.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
